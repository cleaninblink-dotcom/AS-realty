rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'shreyashivpeth@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health check endpoint for connection verification
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }

    // Validation Blueprint for User Profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 128 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        data.role in ['user', 'admin'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().role == 'user'; // Prevent self-assigning admin role

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        (
          (request.auth.uid == userId &&
           isValidUserProfile(incoming()) &&
           incoming().id == existing().id &&
           incoming().role == existing().role && // Prevent privilege escalation
           incoming().createdAt == existing().createdAt &&
           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'updatedAt'])) ||
          isAdmin()
        );

      allow delete: if isAdmin();

      // User Favorites Subcollection: /users/{userId}/favorites/{propertyId}
      match /favorites/{propertyId} {
        allow get: if isValidId(propertyId) && (request.auth.uid == userId || isAdmin());
        allow list: if request.auth.uid == userId || isAdmin();

        allow create: if isValidId(propertyId) &&
          request.auth.uid == userId &&
          incoming().keys().hasAll(['id', 'userId', 'propertyName', 'savedAt']) &&
          incoming().keys().hasOnly(['id', 'userId', 'propertyName', 'propertyPrice', 'propertyLocation', 'propertyImage', 'savedAt']) &&
          incoming().id is string && incoming().id.size() <= 128 &&
          incoming().userId == request.auth.uid &&
          incoming().propertyName is string && incoming().propertyName.size() <= 256 &&
          incoming().savedAt is string && incoming().savedAt.size() <= 64;

        allow delete: if isValidId(propertyId) && (request.auth.uid == userId || isAdmin());
      }
    }

    // Validation Blueprint for Site Visit Bookings
    function isValidVisit(data) {
      return data.keys().hasAll(['id', 'userId', 'fullName', 'phone', 'propertyName', 'visitDate', 'visitTime', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'fullName', 'phone', 'email', 'propertyName', 'visitDate', 'visitTime', 'visitType', 'notes', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 128 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        data.propertyName is string && data.propertyName.size() <= 256 &&
        data.visitDate is string && data.visitDate.size() <= 32 &&
        data.visitTime is string && data.visitTime.size() <= 64 &&
        (!('visitType' in data) || (data.visitType is string && data.visitType.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Book Visits Collection: /bookVisits/{visitId}
    match /bookVisits/{visitId} {
      allow get: if isValidId(visitId) && (
        (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin()
      );

      // List query enforced: only user's own bookings or full access for admin
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isValidId(visitId) &&
        isVerifiedUser() &&
        isValidVisit(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending';

      allow update: if isValidId(visitId) &&
        isSignedIn() &&
        isValidVisit(incoming()) &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            incoming().userId == existing().userId &&
            incoming().id == existing().id &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'status', 'visitDate', 'visitTime', 'updatedAt']) &&
            (incoming().status == existing().status || incoming().status == 'cancelled')
          )
        );

      allow delete: if isValidId(visitId) && isAdmin();
    }
  }
}
